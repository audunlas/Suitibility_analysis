name: suitability_correlation_analysis

entry_points:
  train:
    parameters:
      train_data: path
      model: str
    command: "python train.py {train_data} {model} configs/chap_malaria.json"
  predict:
    parameters:
      historic_data: path
      future_data: path
      model: str
      out_file: path
    command: "python predict.py {model} {historic_data} {future_data} {out_file}"
  report:
    parameters:
      model: str
      historic_data: path
      out_file: path
    command: "python report.py {model} {historic_data} {out_file}"

required_covariates:
  - rainfall
  - mean_temperature
  - humidity

allow_free_additional_continuous_covariates: true
