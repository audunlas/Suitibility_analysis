name: suitability_correlation_analysis

entry_points:
  train:
    parameters:
      train_data: path
      model: str
    command: "touch {model}"
  report:
    parameters:
      model: str
      historic_data: path
      out_file: path
    command: "python report.py {model} {historic_data} {out_file}"

required_covariates:
  - rainfall
  - mean_temperature
  - humidity

allow_free_additional_continuous_covariates: true
